# Backend environment template — copy to `.env` and fill in real values.
#
# `.env` is gitignored. Anything you actually use in prod must be set on the
# host (systemd `EnvironmentFile=` or your secrets store) and MUST NOT be
# committed. This file is a reference for which keys exist and what shape
# they take; it carries no secrets.
#
# SECURITY NOTE (C3 + M4):
#   settings.py is fail-closed:
#     - DEBUG defaults to False. Leave it that way for production.
#     - SECRET_KEY is REQUIRED when DEBUG=False. If missing, Django
#       refuses to start with ImproperlyConfigured — so a forgotten
#       .env on a fresh deploy is loud, not silent.
#     - ALLOWED_HOSTS defaults to cases.raisethevoices.org,
#       www.cases.raisethevoices.org when DEBUG=False. Set this
#       explicitly to add staging/dev hosts (e.g. ALLOWED_HOSTS=
#       cases.raisethevoices.org,staging.cases.raisethevoices.org).
#       Local dev sets ALLOWED_HOSTS=* in .env to keep the historical
#       "any host" behaviour.
#   Generate a fresh secret with:
#     python -c "from django.core.management.utils import \
#         get_random_secret_key; print(get_random_secret_key())"

# --- Core Django ----------------------------------------------------------
DEBUG=False
# REQUIRED when DEBUG=False. Generate with `get_random_secret_key` (see
# above). NEVER commit a real value.
SECRET_KEY=change-me
# Comma-separated. Defaults to cases.raisethevoices.org,
# www.cases.raisethevoices.org when DEBUG=False. Use '*' for local dev.
ALLOWED_HOSTS=cases.raisethevoices.org,127.0.0.1

# --- Postgres (10.0.0.100:5432, shared dev DB) -------------------------
PG_DB=testimonies_world
PG_USER=testimonies
PG_PASSWORD=
PG_HOST=10.0.0.100
PG_PORT=5432

# --- Subpath deployment --------------------------------------------------
# REQUIRED for prod (sets STATIC_URL / MEDIA_URL under /testimonies/).
# Leave EMPTY for local dev (Django serves at /, not /testimonies/).
# Audit H-8: nginx proxies only /testimonies/* paths — with SCRIPT_NAME
# empty, the smoke test still passes but /testimonies/static/ and
# /testimonies/media/ return 404 in prod.
SCRIPT_NAME=/testimonies
CORS_ALLOWED_ORIGINS=https://cases.raisethevoices.org
CSRF_TRUSTED_ORIGINS=https://cases.raisethevoices.org

# --- Google OAuth ------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (casework notifications) -----------------------------------
# Dev defaults to the console backend so notifications land in stdout.
# Production routes through Migadu — an external transactional mailer
# picked over self-hosted Postfix to keep us out of spam lists.
#
# Migadu recipe (see https://migadu.com/guides/ for canonical):
#   host:   smtp.migadu.com
#   port:   465 with implicit SSL  (recommended)
#         | 587 with STARTTLS        (fallback if 465 is blocked)
#   auth:   full mailbox email address + password
#   from:   must live on the same domain as the mailbox, otherwise
#           recipients see "Sent on behalf of" and it looks phishy.
#
# Set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend in
# production. EMAIL_USE_TLS (STARTTLS) and EMAIL_USE_SSL (implicit TLS)
# are mutually exclusive — pick the one that matches your chosen port.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.migadu.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=noreply@your-migadu-domain.example
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Testimonies.world <noreply@your-migadu-domain.example>
SITE_URL=https://cases.raisethevoices.org
# --- E2E test-only auth bootstrap -------------------------------------
# See cases/test_auth.py for the security model. Both vars must be
# set for /__test__/login/ to be reachable.
# PRODUCTION: ENABLE_E2E_TEST_AUTH must be False — leaving True exposes
# the /__test__/login/ endpoint to anyone who knows the token (see
# audit C-2). Set to True only in CI / local dev where the token
# itself is treated as a shared secret.
ENABLE_E2E_TEST_AUTH=False
# 32+ chars of randomness. Rotate alongside SECRET_KEY if you ever
# suspect either has leaked.
TESTIMONIAL_E2E_AUTH_TOKEN=
