# Backend environment template — copy to `.env` and fill in real values.
#
# `.env` is gitignored. Anything you actually use in prod must be set on the
# host (systemd `EnvironmentFile=` or your secrets store) and MUST NOT be
# committed. This file is a reference for which keys exist and what shape
# they take; it carries no secrets.

# --- Core Django ----------------------------------------------------------
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=cases.raisethevoices.org,127.0.0.1

# --- Postgres (10.0.0.100:5432, shared dev DB) -------------------------
PG_DB=testimonies_world
PG_USER=testimonies
PG_PASSWORD=
PG_HOST=10.0.0.100
PG_PORT=5432

# --- Subpath deployment --------------------------------------------------
SCRIPT_NAME=
CORS_ALLOWED_ORIGINS=https://cases.raisethevoices.org
CSRF_TRUSTED_ORIGINS=https://cases.raisethevoices.org

# --- Google OAuth ------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (casework notifications) -----------------------------------
# Dev defaults to the console backend so notifications land in stdout.
# Production routes through Migadu — an external transactional mailer
# picked over self-hosted Postfix to keep us out of spam lists.
#
# Migadu recipe (see https://migadu.com/guides/ for canonical):
#   host:   smtp.migadu.com
#   port:   465 with implicit SSL  (recommended)
#         | 587 with STARTTLS        (fallback if 465 is blocked)
#   auth:   full mailbox email address + password
#   from:   must live on the same domain as the mailbox, otherwise
#           recipients see "Sent on behalf of" and it looks phishy.
#
# Set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend in
# production. EMAIL_USE_TLS (STARTTLS) and EMAIL_USE_SSL (implicit TLS)
# are mutually exclusive — pick the one that matches your chosen port.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.migadu.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=noreply@your-migadu-domain.example
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Testimonies.world <noreply@your-migadu-domain.example>
SITE_URL=https://cases.raisethevoices.org