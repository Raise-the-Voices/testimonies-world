# /etc/systemd/system/rtv-cases-frontend.service
#
# Canonical content for the rtv-cases-frontend systemd unit (SvelteKit
# Node adapter). Deployed automatically by scripts/deploy.sh.
#
# IMPORTANT: --bind is not used here because SvelteKit's Node adapter
# binds via env vars PORT and HOST. PORT must be 3000 and HOST must
# be 127.0.0.1 — nginx proxies everything that isn't /api/, /admin/,
# /accounts/, /events/, /media/, /static/, or /_app/ to that socket
# (see scripts/nginx/rtv-cases `upstream rtv_cases_frontend`).
#
# NOTE: The ExecStart below is a best-guess reconstruction based on the
# deploy.sh fallback and deploy.yml env section, since the on-host
# unit wasn't shared. Verify against the actual unit on prod before
# merging the PR — if the real ExecStart differs, update this file
# and re-deploy.

[Unit]
Description=RTV Cases SvelteKit frontend (Node adapter)
After=network.target
# Restart-storm cap. systemd.unit(5) requires StartLimit* under [Unit];
# under [Service] they are silently ignored, leaving the service free
# to spam-restart in a tight loop. 10 restarts in 5 min is well above
# any legitimate deploy-time recycling.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/rtv-cases/frontend
EnvironmentFile=/opt/rtv-cases/frontend/.env.production
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=ORIGIN=https://cases.raisethevoices.org
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --enable-source-maps build/index.js
Restart=always
RestartSec=5

# Graceful shutdown: send SIGTERM, let adapter-node drain in-flight
# requests for up to 30s, then SIGKILL. adapter-node (kit ≥ 2.x) ships
# a SIGTERM handler that closes the HTTP server before exiting; the 30s
# ceiling covers a worst-case SSR render of a slow /api/ roundtrip.
KillSignal=SIGTERM
TimeoutStopSec=30

# Same restart-storm cap as the backend; declared in [Unit] above so
# systemd actually honors it.
StandardOutput=journal
StandardError=journal
# MemoryHigh gives the kernel a soft pressure threshold below the
# hard MemoryMax OOM-kill. Node doesn't act on it directly, but
# systemd status surfaces cgroup memory pressure to operators, and
# the kernel reclaims under pressure before reaching the kill line.
MemoryHigh=400M
MemoryMax=512M
CPUQuota=100%

# Audit M-12: systemd hardening, mirroring rtv-cases-db-backup.service.
#   - NoNewPrivileges: refuse setuid/setgid binary execution.
#   - PrivateTmp: nothing in /tmp leaks across processes.
#   - ProtectSystem=strict: the filesystem is read-only except for
#     /dev (PTY, etc.) and explicit ReadWritePaths=.
#   - ProtectHome: the home dir tree is invisible to the service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
