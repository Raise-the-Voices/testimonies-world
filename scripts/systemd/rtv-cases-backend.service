# /etc/systemd/system/rtv-cases-backend.service
#
# Canonical content for the rtv-cases-backend systemd unit. Deployed
# automatically by scripts/deploy.sh to /etc/systemd/system/ and
# reloaded via `sudo systemctl daemon-reload && sudo systemctl restart
# rtv-cases-backend`.
#
# IMPORTANT: --bind MUST be 127.0.0.1:8040 — nginx proxies /api/* to
# that exact socket (see scripts/nginx/rtv-cases `upstream
# rtv_cases_backend`). On 2026-08-30 the on-host unit had
# 127.0.0.1:8000 due to a paste/install mistake, which made every
# nginx → backend request return 502. This file pins the right value.

[Unit]
Description=RTV Cases Django backend
After=network.target
# Restart-storm cap. systemd.unit(5) requires StartLimit* under [Unit];
# under [Service] they are silently ignored, leaving the service free
# to spam-restart in a tight loop. 10 restarts in 5 min is well above
# any legitimate deploy-time recycling.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/rtv-cases/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/rtv-cases/backend/.env
ExecStart=/opt/rtv-cases/backend/.venv/bin/gunicorn \
    testimonies.wsgi:application \
    --bind 127.0.0.1:8040 \
    --workers 2 \
    --worker-class gthread \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5
# Same restart-storm cap as declared in [Unit] above.
# Explicit journal routing (also the default for simple services, but
# pinned here so a future maintainer changing the gunicorn logfile
# flags above won't accidentally break log collection).
StandardOutput=journal
StandardError=journal
MemoryMax=512M
CPUQuota=100%

# Audit M-12: systemd hardening, mirroring rtv-cases-db-backup.service.
#   - NoNewPrivileges: refuse setuid/setgid binary execution.
#   - PrivateTmp: nothing in /tmp leaks across processes.
#   - ProtectSystem=strict: the filesystem is read-only except for
#     /dev (PTY, etc.) and explicit ReadWritePaths=.
#   - ProtectHome: the home dir tree is invisible to the service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
