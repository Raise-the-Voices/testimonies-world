# .env.example — shared by docker compose and the backend image.
# Copy to .env (which is gitignored) and fill in real values.

# --- Django core ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=cases.raisethevoices.org,demos.linkedtrust.us,127.0.0.1
SCRIPT_NAME=/testimonies
CSRF_TRUSTED_ORIGINS=https://cases.raisethevoices.org,https://demos.linkedtrust.us

# --- Database ---
# For the prod-remote profile, point PG_HOST at the production VM.
# For the dev + prod-pg profiles, the compose-managed `db` service
# is reachable as `db` on the compose network.
PG_HOST=10.0.0.100
PG_PORT=5432
PG_DB=testimonies_world
PG_USER=testimonies
PG_PASSWORD=change-me
# Uncomment for local dev (sqlite, no Postgres needed)
# USE_SQLITE=1

# --- Cache / Redis ---
# Compose sets this to redis://redis:6379/0 by default; override
# here for a split-network deployment (e.g. a managed ElastiCache).
REDIS_URL=redis://redis:6379/0

# --- Email (casework notifications via Migadu) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.migadu.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@<migadu-domain>
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Testimonies.world <noreply@<migadu-domain>>
SITE_URL=https://demos.linkedtrust.us/testimonies

# --- OAuth (allauth Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sentry (optional) ---
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENV=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Frontend (used by both compose and the frontend image build) ---
PUBLIC_BASE_PATH=/testimonies
ORIGIN=https://cases.raisethevoices.org

# --- Frontend Sentry (PUBLIC_* so the client bundle sees them) ---
# Leave PUBLIC_SENTRY_DSN empty to disable Sentry entirely; init()
# becomes a no-op when DSN is the empty string.
#
# Read via `$env/dynamic/public` in hooks.client.ts / hooks.server.ts,
# so an unset var won't fail the build — it'll be `undefined` and the
# `?? ''` fallback kicks in. To enable Sentry, fill in the four
# vars below in `.env` (which is gitignored) on the host.
#
# DSN looks like https://<key>@o<org>.ingest.sentry.io/<project>.
# Find / create it in the Sentry project settings (Settings → Client
# Keys (DSN)).
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENV=development
# 0.0 disables tracing; 0.1 samples 10% of sessions, etc. Keep this
# low in production until you've measured the cost.
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0
# Optional: pin release for sourcemap uploads (matches backend
# SENTRY_RELEASE for unified dashboards).
PUBLIC_SENTRY_RELEASE=

# --- gunicorn tuning (backend/Dockerfile CMD) ---
WEB_CONCURRENCY=2
WEB_THREADS=2
WEB_TIMEOUT=60
