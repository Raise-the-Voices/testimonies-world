backend/contacts/migrations/__pycache__
backend/testimonies/__pycache__
backend/testimonies/migrations/__pycache__
frontend/node_modules
frontend/build
frontend/.svelte-kit
frontend/src/lib/api/generated
node_modules
__pycache__
*.pyc
*.pyo
*.pyd
.DS_Store
*.swp
.idea
