{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"gen:api": "node scripts/run-spectacular.js && orval --config ./orval.config.ts",
		"gen:api:check": "node scripts/run-spectacular.js && orval --config ./orval.config.ts && cd .. && git diff --exit-code -- frontend/src/lib/api/generated/ openapi.yml",
		"audit:lh": "bash ../scripts/audit-lighthouse.sh http://localhost:3040/testimonies/",
		"audit:lh:build": "PUBLIC_BASE_PATH=/testimonies npm run build && bash ../scripts/audit-lighthouse.sh http://localhost:4173/testimonies/"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/svelte": "^5.4.2",
		"orval": "^7.21.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@fontsource/pt-sans": "^5.3.0",
		"@sentry/sveltekit": "^10.75.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"decimal.js": "^10.6.0",
		"isomorphic-dompurify": "^2.36.0",
		"zod": "^4.5.4"
	}
}
