# Single source of truth for the SvelteKit base path. Read by:
#   - svelte.config.js (via process.env, exported from CI/deploy.sh)
#   - .github/workflows/deploy.yml — exported before `npm run build`
#   - scripts/systemd/rtv-cases-frontend.service — via EnvironmentFile=
# Change this value in ONE place; CI fails if the file is missing.
PUBLIC_BASE_PATH=/testimonies