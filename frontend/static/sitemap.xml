<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap — covers the public, role-independent routes.
  Authenticated routes (/dashboard, /casework, /contacts, /submit,
  /reports, /watchdog, /settings, /notifications) are excluded: no
  search engine should be indexing them, and crawlers without
  session cookies get 401/403.

  Entity URLs (/persons/<id>) are NOT listed here — they would
  require a SvelteKit `+server.ts` endpoint that hits the
  /api/persons/ endpoint to enumerate published cases. Backend-driven
  sitemap is out of scope for the static asset approach here.

  Update `lastmod` when shipping notable changes to the homepage
  or statistics page; SvelteKit serves the file from build/.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
	<url>
		<loc>/</loc>
		<changefreq>daily</changefreq>
		<priority>1.0</priority>
	</url>
	<url>
		<loc>/persons</loc>
		<changefreq>daily</changefreq>
		<priority>0.9</priority>
	</url>
	<url>
		<loc>/statistics</loc>
		<changefreq>weekly</changefreq>
		<priority>0.7</priority>
	</url>
	<url>
		<loc>/accounts/google/login/</loc>
		<changefreq>monthly</changefreq>
		<priority>0.3</priority>
	</url>
</urlset>
